# Copy this file to .env and replace the placeholders. Never commit .env.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
SESSION_SECRET=replace-with-a-long-random-secret

# Use the complete PostgreSQL/Supabase connection URI.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Supabase Storage S3 credentials; required for image upload and retention cleanup.
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=portfolio-media
S3_ACCESS_KEY=replace-with-storage-access-key
S3_SECRET_KEY=replace-with-storage-secret-key
# Optional for Supabase's standard public bucket URL; set for custom S3/CDN URLs.
# S3_PUBLIC_BASE_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/portfolio-media
